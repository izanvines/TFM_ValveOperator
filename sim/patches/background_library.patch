+
+@register_asset
+class OfficeGaussianSplatBackground(LibraryBackground):
+    """Office reconstruction (Gaussian Splatting / NuRec) photorealistic backdrop.
+
+    Scale/position/rotation come from env vars so we can align the (arbitrary NuRec
+    coordinate frame) splat to the metric scene without re-editing code:
+      OFFICE_GS_USD   : path to the .usdz       (default /datasets/office_gs/export_sh_optimized.usdz)
+      OFFICE_GS_SCALE : uniform scale factor    (default 1.0)
+      OFFICE_GS_POS   : "x,y,z" translation (m) (default "0,0,0")
+      OFFICE_GS_ROT   : "x,y,z,w" quaternion    (default "0,0,0,1")
+    Visual-only (ObjectType.BASE -> no collision).
+    """
+
+    name = "office_gs"
+    tags = ["background", "gaussian_splat", "nurec"]
+    usd_path = os.environ.get("OFFICE_GS_USD", "/datasets/office_gs/export_sh_optimized.usdz")
+    _scale = float(os.environ.get("OFFICE_GS_SCALE", "1.0"))
+    _pos = tuple(float(v) for v in os.environ.get("OFFICE_GS_POS", "0,0,0").split(","))
+    _rot = tuple(float(v) for v in os.environ.get("OFFICE_GS_ROT", "0,0,0,1").split(","))
+    initial_pose = Pose(position_xyz=_pos, rotation_xyzw=_rot)
+    object_min_z = -0.2
+
+    def __init__(self):
+        super().__init__(scale=(self._scale, self._scale, self._scale))
