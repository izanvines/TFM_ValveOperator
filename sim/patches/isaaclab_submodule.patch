@@ -87,6 +87,27 @@ class XrAnchorManager:
             )
         except Exception as e:
             logger.warning(f"Failed to create XR anchor prim: {e}")
+            # LOCAL PATCH (2026-08-04): ``SingleXFormPrim`` calls
+            # ``SimulationManager._get_backend_utils()``, which Isaac Lab's ``PhysxManager``
+            # does not implement, so anchor creation fails on every run of this stack. The
+            # anchor is a plain ``Xform`` with no physics attached, so author it directly with
+            # USD instead. Without this the anchor prim is missing while the
+            # ``/xrstage/customAnchor`` setting below still points at it, and the headset ends
+            # up at the anchor's parent (the pelvis) instead of at ``anchor_pos``, one metre
+            # below it -- i.e. the operator floats above the robot instead of standing in it.
+            try:
+                import isaacsim.core.utils.stage as stage_utils
+                from pxr import Gf, UsdGeom
+
+                stage = stage_utils.get_current_stage()
+                xform = UsdGeom.Xform.Define(stage, self._xr_anchor_headset_path)
+                xform.ClearXformOpOrder()
+                anchor_pos = tuple(float(v) for v in self._xr_cfg.anchor_pos)
+                xform.AddTranslateOp().Set(Gf.Vec3d(*anchor_pos))
+                xform.AddOrientOp().Set(Gf.Quatf(float(w), float(x), float(y), float(z)))
+                logger.warning(f"Created XR anchor prim via USD fallback at {self._xr_anchor_headset_path}")
+            except Exception as fallback_error:
+                logger.error(f"USD fallback for XR anchor prim also failed: {fallback_error}")
 
         # Configure carb settings for XR rendering
