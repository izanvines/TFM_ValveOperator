+@register_asset
+class Valve(LibraryObject, Openable):
+    """A standpipe hand-wheel valve (real CAD rig).
+
+    A fixed pillar anchored to the world by a baked ``FixedJoint``, carrying a 0.20 m
+    hand-wheel on the ``RevoluteJoint`` that the humanoid turns to open. Modelled as an
+    ``Openable``: openness 0.0 = closed, 1.0 = one full turn. Success at 0.5, i.e. half a
+    revolution.
+
+    The asset is ``valve_rig_arena.usda``, a thin wrapper that references jescobars' CAD
+    rig and re-scopes the revolute travel from the authored 6.5 turns down to one -- see
+    that file's ``doc`` for why the raw limits make teleoperated demos impossible to
+    complete, and why the materials are rebound there. The procedural placeholder this
+    replaced is still on disk as ``valve_handwheel_v1.usda`` (its joint is ``valve_joint``,
+    not ``RevoluteJoint``, so both fields move together if you switch back).
+
+    The wheel centre sits 0.122 m above the asset origin along local +Z, and the rig must
+    be spawned rotated 90 deg about Z for the wheel axis to face the robot -- see
+    ``VALVE_SPAWN_XYZ`` / ``VALVE_SPAWN_QUAT_XYZW`` in ``g1_valve_environment``.
+    """
+
+    name = "valve"
+    tags = ["object", "openable"]
+    usd_path = os.path.join(os.path.dirname(__file__), "usd", "valve_rig_arena.usda")
+    object_type = ObjectType.ARTICULATION
+
+    # Openable affordance parameters
+    openable_joint_name = "RevoluteJoint"
+    openable_threshold = 0.5  # openness > 0.5 counts as "open"
+
+    def __init__(
+        self, instance_name: str | None = None, prim_path: str | None = None, initial_pose: Pose | None = None
+    ):
+        super().__init__(
+            instance_name=instance_name,
+            prim_path=prim_path,
+            initial_pose=initial_pose,
+            openable_joint_name=self.openable_joint_name,
+            openable_threshold=self.openable_threshold,
+        )
+
+
 @register_asset
 class CoffeeMachine(LibraryObject, Pressable):
     """
