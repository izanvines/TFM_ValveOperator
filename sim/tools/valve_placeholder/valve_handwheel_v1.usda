#usda 1.0
(
    defaultPrim = "Valve"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Valve" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    def Xform "pillar" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 20

        def Cylinder "shaft" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            float3[] extent = [(-0.04, -0.04, -0.475), (0.04, 0.04, 0.475)]
            double height = 0.95
            color3f[] primvars:displayColor = [(0.55, 0.57, 0.6)]
            double radius = 0.04
            double3 xformOp:translate = (0, 0, 0.4749999940395355)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "stub" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            float3[] extent = [(-0.06, -0.04, -0.04), (0.06, 0.04, 0.04)]
            double height = 0.12
            color3f[] primvars:displayColor = [(0.55, 0.57, 0.6)]
            double radius = 0.024
            double3 xformOp:translate = (-0.05999999865889549, 0, 0.949999988079071)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def PhysicsFixedJoint "fixed_joint"
    {
        rel physics:body1 = </Valve/pillar>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
    }

    def Xform "wheel" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1
        double3 xformOp:translate = (-0.11999999731779099, 0, 0.949999988079071)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "hub" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "X"
            float3[] extent = [(-0.03, -0.03, -0.03), (0.03, 0.03, 0.03)]
            double height = 0.06
            color3f[] primvars:displayColor = [(0.75, 0.15, 0.12)]
            double radius = 0.03
        }

        def Mesh "rim" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
